PORT=3000
# Must be uppercase DATABASE_URL (not database_url)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
JWT_SECRET=use-at-least-16-random-characters-here
JWT_EXPIRES_IN=7d
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional: comma-separated or single origin for mobile dev
# CORS_ORIGIN=http://localhost:8081
