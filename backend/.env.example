NODE_ENV=development
PORT=3000
# Must be uppercase DATABASE_URL (not database_url)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# At least 32 random characters in production
JWT_SECRET=replace-with-at-least-32-random-characters!!
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=800
OPENAI_TIMEOUT_MS=45000
AI_DAILY_QUOTA=100
# Recent chat turns sent to the tutor (clamped 5–50)
CHAT_HISTORY_LIMIT=20
# Set to 0/false to disable OpenAI Moderation (not recommended)
AI_MODERATION_ENABLED=true
# Required in production (comma-separated allow-list)
CORS_ORIGIN=http://localhost:8081
TRUST_PROXY=false

# Swagger UI (/api/docs) HTTP Basic credentials
# Production: set a strong SWAGGER_PASSWORD (not the default)

# Required in production — HTTPS public site (privacy / deletion pages)

# Required in production — privacy / deletion support contact
SUPPORT_EMAIL=privacy@fluentai.app

# Gmail SMTP (App Password) — required in production for password-reset OTPs
SMTP_USER=yourgmail@gmail.com
SMTP_APP_PASSWORD=your16characterapppassword
EMAIL_FROM=FluentAI <yourgmail@gmail.com>
# Optional: override Gmail service transport with a custom host
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# OTP / password-reset security (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
OTP_SECRET=replace_with_a_secure_random_secret
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
RESET_AUTH_TTL_MINUTES=10
